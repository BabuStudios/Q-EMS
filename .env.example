# --- Database ---
# Local dev (native Postgres) or Docker Compose service name "db".
DATABASE_URL="postgresql://qems:qems@localhost:5432/qems?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-please-use-a-long-random-string"
# Trust the host in self-hosted / Docker deployments.
AUTH_TRUST_HOST="true"

# --- Single-tenant bootstrap ---
# The slug of the organization provisioned by the seed script.
DEFAULT_ORG_SLUG="default"

# --- File storage (S3-compatible: MinIO in dev) — used from Phase 2 onward ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="qems"

# --- E-mail (SMTP) — used from Phase 1 onward ---
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@q-ems.local"
