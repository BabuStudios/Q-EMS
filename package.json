{
  "name": "q-ems",
  "version": "0.1.0",
  "private": true,
  "description": "Integrerat ledningssystem för kvalitet & miljö (IMS) — ISO 9001 + ISO 14001:2026",
  "scripts": {
    "dev": "next dev",
